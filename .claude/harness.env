# harness.env: project settings for the harness hooks and scripts.
# POSIX sh syntax. Never put secrets here.
# A hook that needs a missing key exits 0 silently.

# --- Paths ---
# Sources live at the repo root (no src/ folder).
UI_PATHS_REGEX='^(App\.tsx|index\.tsx|index\.html|legacy\.html|components/.*\.tsx|site/.*\.(ts|tsx)|ink/.*\.ts|figures/.*\.(ts|tsx)|styles/.*\.css)$'  # files whose change needs a design-sync label
BEHAVIOUR_PATHS_REGEX='^((App|index|types)\.tsx?|(components|config|contexts|data|utils|site|ink|figures|content|ontology)/.*\.(ts|tsx)|scripts/build-(tokens|ontology)\.mjs|tokens\.json)$'  # files whose change needs a spec update
SRC_PATHS_REGEX='^([^/]+\.(ts|tsx)|(components|config|contexts|data|utils|site|ink|figures|content|ontology)/.*\.(ts|tsx))$'  # source files the test-nudge counts
LESSONS_FILE='tasks/lessons.md'                    # lessons log checked by spec-sync
FINDINGS_DIR='docs/testing'                        # findings logs: $FINDINGS_DIR/<YYYY-MM-DD>/findings.md

# --- Design ---
DESIGN_DOC='DESIGN.md'                             # design source of truth
SPEC_DOC='SPEC.md'                                 # running spec
DRIFT_ALLOW_HEX='#112233,#AABBCC'                  # hex colours allowed only on canvas boards (comma list)
TOKEN_SECTION_REGEX='^#+ .*[Tt]oken'               # heading that opens the token section in DESIGN_DOC (drift-check)
DRIFT_CHECK=''                                     # optional path to drift-check.mjs (default: found next to the hooks)

# --- Version ---
VERSION_FILE='package.json'                        # file that holds the asset version constant
VERSION_TOKEN='"version"'                          # grep token for the version constant

# --- Commands ---
TEST_CMD='npm test --silent'                      # vitest run
LINT_CMD=''                                        # no linter in this project
TYPECHECK_CMD='npx tsc --noEmit'                   # type check command
DEADCODE_CMD=''                                    # no dead-code tool in this project

# --- Deploy ---
# No deploy step. vercel.json is present; Vercel deploys outside the harness.
DEPLOY_CMD=''                                      # full deploy command (gate.sh --deploy)
DEPLOY_TARGET=''                                   # name shown in the deploy confirmation
DEPLOY_FILES_REGEX=''                              # changed files that count as deployable
DEPLOY_FILE_CMD=''                                 # one-file fallback; {} is the file path
# GATE_CONFIRM=deploy is an environment variable, not a file key. Set it for non-interactive deploys only.

# --- Tuning ---
TEST_PROMPT_REGEX='screen ?shot|live test|sandbox|looks (wrong|off)'  # prompts that start the design-sync nudge
TEST_MATCH_REGEX='npm (run )?test|npx jest|jest|vitest|pytest|gate\.sh'  # any Bash command matching this counts as a test run (test-nudge)
DEPLOY_GUARD_REGEX='project:deploy|file:upload|vercel deploy|fly deploy|npm publish|git push'  # Bash commands that need an explicit yes (deploy-guard)
FINDINGS_LINT=''                                   # optional path to findings-lint.mjs (default: .claude/skills/design-sync-loop/scripts/, then ~/.claude/skills/...)
GATE_SH=''                                         # optional path to gate.sh for the git pre-push hook
TEST_NUDGE_BLOCK='0'                               # 1 = block the first Stop once when tests are stale
HARNESS_STRICT='0'                                 # 1 = the git pre-commit runner exits 1 on any warning
# Screenshot harness (usually set per command, not here): SIZE=380,640  THEME=light|dark|both  BUDGET=3000  CHROME=<path>
